# ==============================================================================
# Performance Testing AI - Environment Configuration (Phase 2)
# ==============================================================================

# Mode Selection:
# Set to 'true' to run deterministic pipeline locally without any API keys or costs.
# Set to 'false' to enable live LLM inference with one of the providers below.
PERFORMANCE_TESTING_MOCK_MODE=true

# Active LLM Provider:
# Options: 'mock', 'openai', 'gemini', 'ollama', 'anthropic'
# If omitted and MOCK_MODE=false, provider will be auto-detected from available keys.
LLM_PROVIDER=mock

# ------------------------------------------------------------------------------
# Provider: Google Gemini
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini/gemini-3.5-flash

# ------------------------------------------------------------------------------
# Provider: OpenAI
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# ------------------------------------------------------------------------------
# Provider: Ollama / Local Models (Zero Cost, Self-Hosted)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=ollama/llama3.2

# ------------------------------------------------------------------------------
# Provider: Anthropic
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=anthropic/claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# CrewAI Telemetry
# ------------------------------------------------------------------------------
CREWAI_TELEMETRY_OPT_OUT=true
